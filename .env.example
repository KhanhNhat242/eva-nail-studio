# Sao chép thành .env (KHÔNG commit .env). Xem docs/DEPLOY.md.

# MongoDB — local: mongodb://127.0.0.1:27017 · Atlas: mongodb+srv://<user>:<pass>@<cluster>/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=eva_nail_studio

# Tài khoản CMS (/admin)
ADMIN_USERNAME=admin
# Tạo bằng: node scripts/hash-password.mts "mat-khau-cua-ban"
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên ≥ 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
